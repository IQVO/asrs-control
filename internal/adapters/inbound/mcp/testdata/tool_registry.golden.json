  {
    "_meta": {
      "com.warehouse/authority": "L1"
    },
    "annotations": {
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "List an AS/RS's STORE and RETRIEVE jobs newest first, optionally of one status, keyset-paged (a page's nextCursor feeds the next call's cursor; empty when there is no further page). Items have the get_storage_job shape. Internal reshuffles are never listed. Read-only.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "asrsId": {
          "description": "the AS/RS id, e.g. ASRS1",
          "type": "string"
        },
        "cursor": {
          "description": "optional keyset cursor: the previous page's nextCursor; omitted means the newest page",
          "type": "string"
        },
        "limit": {
          "description": "optional page size 1..100; omitted means 20",
          "type": "integer"
        },
        "status": {
          "description": "optional status filter: QUEUED, DISPATCHED, ACKNOWLEDGED, CANCEL_REQUESTED, AWAITING_ARRIVAL, DONE, FAILED or CANCELLED; omitted means every status",
          "type": "string"
        }
      },
      "required": [
        "asrsId"
      ],
      "type": "object"
    },
    "name": "list_storage_jobs",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "accepted_at": {
                "type": "string"
              },
              "asrs_id": {
                "type": "string"
              },
              "container_id": {
                "type": "string"
              },
              "ended_at": {
                "type": [
                  "null",
                  "string"
                ]
              },
              "kind": {
                "type": "string"
              },
              "plc_reason": {
                "type": "string"
              },
              "port_id": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "reference": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "storage_job_id": {
                "type": "string"
              }
            },
            "required": [
              "storage_job_id",
              "asrs_id",
              "kind",
              "container_id",
              "port_id",
              "status",
              "accepted_at"
            ],
            "type": "object"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "nextCursor": {
          "type": "string"
        }
      },
      "required": [
        "items"
      ],
      "type": "object"
    }
  }
]
