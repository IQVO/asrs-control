          "type": "integer"
        },
        "positions_total": {
          "type": "integer"
        },
        "units_available": {
          "type": "integer"
        },
        "units_total": {
          "type": "integer"
        }
      },
      "required": [
        "asrs_id",
        "units_total",
        "units_available",
        "positions_total",
        "positions_free",
        "open_jobs"
      ],
      "type": "object"
    }
  },
